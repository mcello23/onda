<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled slightly inside the 66dp adaptive safe zone so nothing clips on any launcher mask -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">

        <!-- Upper O arc -->
        <path
            android:pathData="M31,44 A24,24 0 1,1 77,44"
            android:strokeAlpha="0.95"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="6.5" />

        <!-- Lower softer O arc -->
        <path
            android:pathData="M77,64 A24,24 0 1,1 31,64"
            android:strokeAlpha="0.45"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="6.5" />

        <!-- Continuous flowing radio / ocean wave -->
        <path
            android:pathData="M23,54 C31,54 34,38 43,38 C52,38 56,70 65,70 C74,70 77,54 85,54"
            android:strokeLineCap="round"
            android:strokeWidth="7.2">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:endX="85"
                    android:endY="54"
                    android:startX="23"
                    android:startY="54"
                    android:type="linear">
                    <item
                        android:color="#FFE0F2FE"
                        android:offset="0.0" />
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Coral Live Pulse Dot -->
        <path
            android:fillColor="#FFFF7A59"
            android:pathData="M71.5,31 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z" />
    </group>
</vector>
