<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include only non-sensitive app settings, favorite stations, and podcast subscriptions.
             Everything else (widget snapshots, downloaded podcasts, caches) is excluded implicitly. -->
        <include domain="sharedpref" path="onda.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="onda.xml" />
    </device-transfer>
</data-extraction-rules>
