<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/widget_compact_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/widget_compact_art"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/widget_chip_bg"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_radio" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_compact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_title"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_compact_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_compact_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_btn_tonal"
        android:contentDescription="@string/action_previous"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_skip_previous"
        android:tint="@color/widget_on_surface" />

    <ImageButton
        android:id="@+id/widget_compact_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_play_bg"
        android:contentDescription="@string/action_play_pause"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        android:tint="@color/widget_on_primary" />

    <ImageButton
        android:id="@+id/widget_compact_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_btn_tonal"
        android:contentDescription="@string/action_next"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_skip_next"
        android:tint="@color/widget_on_surface" />

</LinearLayout>
